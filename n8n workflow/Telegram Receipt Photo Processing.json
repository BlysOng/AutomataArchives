    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const output =\n  $json.content?.parts?.[0]?.text ||\n  $json.text ||\n  $json.output ||\n  '';\n\nif (!output) {\n  throw new Error('Gemini returned no text output.');\n}\n\nconst cleaned = output\n  .replace(/^```json\\s*/i, '')\n  .replace(/^```\\s*/i, '')\n  .replace(/\\s*```$/i, '')\n  .trim();\n\nlet receipt;\n\ntry {\n  receipt = JSON.parse(cleaned);\n} catch (error) {\n  throw new Error(`Gemini output is not valid JSON: ${cleaned}`);\n}\n\nreturn {\n  json: receipt\n};"
      },
      "type": "n8n-nodes-base.code",
