      "parameters": {
        "jsCode": "const message = $json.message;\n\nif (!message) {\n  throw new Error('No Telegram message found.');\n}\n\nif (!message.photo || message.photo.length === 0) {\n  throw new Error('No receipt photo was found in the Telegram message.');\n}\n\nconst largestPhoto = message.photo.reduce((largest, photo) => {\n  const largestPixels = largest.width * largest.height;\n  const currentPixels = photo.width * photo.height;\n\n  return currentPixels > largestPixels ? photo : largest;\n});\n\nreturn [\n  {\n    json: {\n      chat_id: message.chat.id,\n      message_id: message.message_id,\n      telegram_file_id: largestPhoto.file_id,\n      submission_timestamp: message.date,\n      submission_date: new Date(message.date * 1000)\n        .toISOString()\n        .split('T')[0]\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
