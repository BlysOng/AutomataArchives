    {
      "parameters": {
        "jsCode": "const emails = $('Resolve Gmail Label').all();\n\nconst output = [];\n\nfor (const item of emails) {\n  const binary = item.binary || {};\n\n  for (const [binaryKey, file] of Object.entries(binary)) {\n    output.push({\n      json: {\n        ...item.json,\n\n        originalFileName: file.fileName || binaryKey,\n        mimeType: file.mimeType || '',\n      },\n\n      binary: {\n        data: file,\n      },\n    });\n  }\n}\n\nreturn output;"
      },
