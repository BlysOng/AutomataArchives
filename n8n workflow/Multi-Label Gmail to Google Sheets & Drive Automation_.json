    {
      "parameters": {
        "jsCode": "const labels = $input.all();\n\n// Get the processed email records from the earlier Code node\nconst emails = $('Code').all();\n\n// Create a lookup:\n// Gmail Label ID → Gmail Label Name\nconst labelMap = {};\n\nfor (const item of labels) {\n  const id = item.json.id;\n  const name = item.json.name;\n\n  if (id && name) {\n    labelMap[id] = name;\n  }\n}\n\n// Add the actual label name to each email\nreturn emails.map(item => {\n  const json = item.json;\n  const binary = item.binary || {};\n\n  const matchingLabels = (json.labelIds || [])\n    .filter(labelId => labelMap[labelId])\n    .map(labelId => labelMap[labelId])\n    .filter(labelName =>\n      ['label1', 'label2', 'label3'].includes(labelName)\n    );\n\n  return {\n    json: {\n      ...json,\n      label: matchingLabels.length > 0\n        ? matchingLabels[0]\n        : '',\n      matchingLabels,\n    },\n\n    // Preserve the attachment\n    binary: Object.keys(binary).length > 0\n      ? binary\n      : undefined,\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        640
      ],
      "id": "3b2cb644-7d8a-4cd1-b612-a19bf1c08eeb",
      "name": "Resolve Gmail Label"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const json = item.json;\n  const binary = item.binary || {};\n\n  // --------------------------------\n  // Gmail headers\n  // --------------------------------\n  const headers = json.headers || {};\n\n  // Helper to safely get a header\n  const getHeader = (name) => {\n    const key = Object.keys(headers).find(\n      key => key.toLowerCase() === name.toLowerCase()\n    );\n\n    return key ? headers[key] : '';\n  };\n\n  // --------------------------------\n  // Sender\n  // --------------------------------\n  const fromHeader = getHeader('from');\n\n  let senderName = '';\n  let senderEmail = '';\n\n  const emailMatch = fromHeader.match(/<([^>]+)>/);\n\n  if (emailMatch) {\n    senderEmail = emailMatch[1].trim();\n\n    senderName = fromHeader\n  .replace(/^From:\\s*/i, '')\n  .replace(/<[^>]+>/, '')\n  .replace(/\"/g, '')\n  .trim();\n  } else {\n    senderEmail = fromHeader.trim();\n    senderName = fromHeader.trim();\n  }\n\n  // --------------------------------\n  // Subject\n  // --------------------------------\n  const subject = getHeader('subject')\n  .replace(/^Subject:\\s*/i, '')\n  .trim();\n  // --------------------------------\n  // Received Date & Time\n  // --------------------------------\n  const internalDate = json.internalDate\n    ? new Date(Number(json.internalDate))\n    : new Date();\n\n  const receivedDate = internalDate\n    .toISOString()\n    .split('T')[0];\n\n  const receivedTime = internalDate\n    .toISOString()\n    .split('T')[1]\n    .split('.')[0];\n\n  // --------------------------------\n  // Gmail Labels\n  // --------------------------------\n  const labelIds = json.labelIds || [];\n\n  // --------------------------------\n  // Attachments\n  // --------------------------------\n  const attachmentNames = Object.values(binary)\n    .map(file => file.fileName)\n    .filter(Boolean);\n\n  output.push({\n    json: {\n      emailId: json.id || '',\n      senderName,\n      senderEmail,\n      subject,\n      labelIds,\n      receivedDate,\n      receivedTime,\n      hasAttachment:\n        attachmentNames.length > 0 ? 'Yes' : 'No',\n      attachmentCount: attachmentNames.length,\n      attachmentNames: attachmentNames.join(', '),\n    },\n\n    binary:\n      Object.keys(binary).length > 0\n        ? binary\n        : undefined,\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
